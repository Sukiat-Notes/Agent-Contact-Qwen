# ============================================================
# .env.example
# PURPOSE : TEMPLATE for environment variables. Copy this file
#           to `backend/.env` (which is git-ignored) and adjust
#           values for your machine.
# STATUS  : USED - every variable below is read by
#           backend/src/config/config.js (each has a safe
#           default, so the app still runs without a .env).
# NOTE    : Real .env files may contain secrets and must NEVER
#           be committed (see .gitignore).
# ============================================================

# Port the API server listens on. Default: 3000
PORT=3000

# Path to the JSON "database" file.
# Relative paths are resolved from the repository root.
# Default: data/contacts.json
CONTACTS_DATA_FILE=data/contacts.json

# Log verbosity: silent | error | warn | info | debug
# Default: info
LOG_LEVEL=info

# When true, the API also serves the frontend/ folder at `/`
# (single-server setup). Default: true
SERVE_FRONTEND=true
